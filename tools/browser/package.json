{
  "name": "@vbtech/browser",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test --config playwright.config.ts && playwright test --config contact.playwright.config.ts && playwright test --config contact-active.playwright.config.ts",
    "test:contact": "playwright test --config contact.playwright.config.ts",
    "test:contact-active": "playwright test --config contact-active.playwright.config.ts",
    "accept:contact-emails": "playwright test --config email.playwright.config.ts",
    "package-manager:contract": "node ../../scripts/assert-pnpm-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "typescript": "5.9.3"
  }
}
