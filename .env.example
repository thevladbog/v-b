# Immutable public artifact identity. Replace the placeholder with one reviewed Git SHA.
VBTECH_IMAGE_TAG=ghcr.io/thevladbog/vbtech-web:<40-character-git-sha>
VBTECH_DOMAIN=v-b.tech
VBTECH_WWW_DOMAIN=www.v-b.tech

# Existing edge authorities are inventory input, not values managed by this repository.
MARKIRO_EDGE_AUTHORITIES=admin.markiro.app,kiosk.markiro.app,markiro.app

# Supply the reviewed HTTPS function endpoint and its non-secret invocation audience.
VBTECH_FUNCTION_ORIGIN=https://functions.yandexcloud.net/<function-id>
VBTECH_FUNCTION_AUDIENCE=<function-audience>

# Safe default. Enabling requires an ACTIVE consent embedded in the exact web artifact.
VBTECH_SUBMISSION_STATE=disabled
VBTECH_CONSENT_RELEASE=VBT-PD-02/DRAFT

# Secrets such as database credentials, encryption keys, captcha secret and mail credentials
# belong in Lockbox and must never be written to this file.
