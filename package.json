{
  "name": "v-b-tech",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "corepack pnpm run test:unit && corepack pnpm --dir tools/browser test",
    "test:unit": "turbo run test --filter='!@vbtech/browser'",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "2.10.4"
  }
}
