---
import { SITE_CONTENT } from "@vbtech/content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/landing.css";

const page = SITE_CONTENT.ru;
---

<BaseLayout
  locale="ru"
  title="Страница не найдена / Page not found | v-b.tech"
  description="Запрошенная страница v-b.tech не найдена. The requested v-b.tech page was not found."
  routeKind="secondary"
  noindex={true}
>
  <section class="not-found shell" aria-labelledby="not-found-title">
    <p class="eyebrow">404 / not found</p>
    <h1 id="not-found-title">Страница не найдена.<br />Page not found.</h1>
    <p>
      Проверьте адрес или вернитесь на главную. Check the address or return to a localized home page.
    </p>
    <div class="not-found-actions">
      <a class="button button-primary" href="/">Главная на русском</a>
      <a class="button button-secondary" href="/en/">English home</a>
      <a class="button button-secondary" href="/#contact">Связаться</a>
      <a class="button button-secondary" href="/en/#contact">Contact</a>
    </div>
    <p>{page.footerLine}</p>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100svh - 4.5rem);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.5rem;
    padding-block: 5rem;
  }

  .not-found h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .not-found > p:not(.eyebrow) {
    max-width: 58ch;
    margin: 0;
    color: var(--color-muted);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 40rem) {
    .not-found-actions {
      width: 100%;
      display: grid;
    }
  }
</style>
