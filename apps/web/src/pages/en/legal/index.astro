---
import { listCurrentLegalDocuments } from "@vbtech/legal-documents";
import LegalLayout from "../../../layouts/LegalLayout.astro";

const locale = "en";
const documents = listCurrentLegalDocuments(locale);
const title = "v-b.tech legal documents — drafts";
const description =
  "Register of v-b.tech draft documents: the personal data processing policy and consent for the future enquiry form.";
---

<LegalLayout locale={locale} title={title} description={description} route="legal-register">
  <div class="legal-register">
    <header class="legal-register-header">
      <p class="legal-kicker">v-b.tech / legal</p>
      <h1>Legal documents</h1>
      <p>The register contains review candidates only. There are currently no active documents.</p>
    </header>
    <ul class="legal-register-list">
      {documents.map((document) => (
        <li>
          <article>
            <p class="legal-register-meta">{document.code} · {document.identity}</p>
            <h2><a href={document.routes.en}>{document.content.title}</a></h2>
            <p>Status: draft</p>
            <p>{document.content.summary}</p>
          </article>
        </li>
      ))}
    </ul>
  </div>
</LegalLayout>
