---
import { SITE_CONTENT } from "@vbtech/content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localizedPath } from "../../lib/locale.js";

const locale = "en";
const page = SITE_CONTENT[locale];
---

<BaseLayout
  locale={locale}
  title={page.meta.title}
  description={page.meta.description}
  canonicalPath={localizedPath(locale, "home")}
  alternates={[
    { locale: "ru", path: localizedPath("ru", "home") },
    { locale: "en", path: localizedPath("en", "home") },
    { locale: "x-default", path: localizedPath("ru", "home") },
  ]}
>
  <h1 set:html={page.hero.title} />
</BaseLayout>
