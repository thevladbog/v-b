---
import { PUBLIC_CONTACT_SUBMISSION_ENABLED } from "astro:env/client";
import { resolveContactContent, type Locale, type SiteContent } from "@vbtech/content";
import ContactForm from "./ContactForm.astro";
import { resolveContactSubmissionReadiness } from "../lib/form-state.js";

interface Props {
  locale: Locale;
  about: SiteContent["about"];
  contact: SiteContent["contact"];
}

const { locale, about, contact } = Astro.props;
const readiness = resolveContactSubmissionReadiness(PUBLIC_CONTACT_SUBMISSION_ENABLED);
const resolvedContact = resolveContactContent(contact, readiness.submissionEnabled);
const signatureLabel = locale === "ru"
  ? "Влад Богатырев — продуктовая инженерия и эксплуатация"
  : "Vlad Bogatyrev — product engineering and operations";
---

<div class="section about-contact">
  <div class="shell about-grid">
    <section class="about-copy" id="about" data-section="about" aria-labelledby="about-title">
      <p class="eyebrow">{about.eyebrow}</p>
      <h2 id="about-title">{about.title}</h2>
      <p>{about.body}</p>
      <p>{about.bodyTwo}</p>
      <div class="about-signature" aria-label={signatureLabel}>
        <span>Vlad Bogatyrev</span><i aria-hidden="true"></i><small>product / engineering / operations</small>
      </div>
    </section>

    <section class="contact-panel" id="contact" data-section="contact" aria-labelledby="contact-title">
      <p class="eyebrow">{resolvedContact.eyebrow}</p>
      <h2 id="contact-title">{resolvedContact.title}</h2>
      <p class="contact-lead">{resolvedContact.lead}</p>
      <p class="contact-direct-context">{resolvedContact.directContactContext}</p>
      <div class="contact-links">
        <a href="https://t.me/thevladbog" target="_blank" rel="noopener noreferrer" aria-label={resolvedContact.telegramNewTabLabel}>
          <span>{resolvedContact.telegram}</span><b>@thevladbog <i aria-hidden="true">↗</i></b>
        </a>
        <a href="mailto:hello@v-b.tech">
          <span>{resolvedContact.email}</span><b>hello@v-b.tech <i aria-hidden="true">↗</i></b>
        </a>
      </div>
      <ContactForm idPrefix="home-contact" locale={locale} content={resolvedContact} />
    </section>
  </div>
</div>
