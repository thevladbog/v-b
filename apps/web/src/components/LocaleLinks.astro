---
import type { Locale } from "@vbtech/content";
import { localizedPath, type LocalizedRoute } from "../lib/locale.js";

interface Props {
  locale: Locale;
  label: string;
  route?: LocalizedRoute;
}

const { locale, label, route = "home" } = Astro.props;
---

<nav class="locale-links" aria-label={label}>
  <a href={localizedPath("ru", route)} aria-current={locale === "ru" ? "page" : undefined}>RU</a>
  <span aria-hidden="true"> / </span>
  <a href={localizedPath("en", route)} aria-current={locale === "en" ? "page" : undefined}>EN</a>
</nav>
