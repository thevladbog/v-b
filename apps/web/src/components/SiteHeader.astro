---
import { SITE_CONTENT, type Locale } from "@vbtech/content";
import LocaleLinks from "./LocaleLinks.astro";
import ThemeControl from "./ThemeControl.astro";
import Wordmark from "./Wordmark.astro";
import { localizedPath, type LocalizedRoute } from "../lib/locale.js";

interface Props {
  locale: Locale;
  localizedRoute?: LocalizedRoute;
  routeKind?: "home" | "secondary";
}

const {
  locale,
  localizedRoute = "home",
  routeKind = localizedRoute === "home" ? "home" : "secondary",
} = Astro.props;
const page = SITE_CONTENT[locale];
const sectionHref = (fragment: string) =>
  routeKind === "home" ? `#${fragment}` : `${localizedPath(locale, "home")}#${fragment}`;
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <Wordmark locale={locale} label={page.navigation.homeLabel} />
    <button
      class="navigation-toggle"
      id="site-navigation-toggle"
      type="button"
      hidden
      aria-controls="site-navigation"
      aria-expanded="false"
      aria-label={page.navigation.menuOpen}
      data-navigation-toggle
      data-open-label={page.navigation.menuOpen}
      data-close-label={page.navigation.menuClose}
    >
      <span aria-hidden="true"></span>
    </button>
    <nav id="site-navigation" class="site-navigation" aria-label={page.navigation.primaryLabel} data-site-navigation>
      <a href={sectionHref("work")}>{page.navigation.work}</a>
      <a href={sectionHref("expertise")}>{page.navigation.expertise}</a>
      <a href={sectionHref("approach")}>{page.navigation.approach}</a>
      <a href={sectionHref("about")}>{page.navigation.about}</a>
      <a class="header-contact" href={sectionHref("contact")}>{page.navigation.contact}</a>
    </nav>
    <div class="header-preferences">
      <LocaleLinks locale={locale} label={page.navigation.languageLabel} route={localizedRoute} />
      <ThemeControl locale={locale} />
    </div>
  </div>
</header>
