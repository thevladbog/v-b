---
import {
  PUBLIC_CONTACT_SUBMISSION_ENABLED,
  PUBLIC_SMARTCAPTCHA_SITE_KEY,
} from "astro:env/client";
import type { Locale, SiteContent } from "@vbtech/content";
import { CONTACT_FIELD_LIMITS } from "@vbtech/contracts";
import { localizedPath } from "../lib/locale.js";
import { resolveContactSubmissionReadiness } from "../lib/form-state.js";
import { assertReviewedPublicSmartCaptchaSiteKey } from "../lib/contact-runtime-config.js";

interface InternalContactFixture {
  siteKey: string;
  loadTimeoutMs: number;
}

interface Props {
  idPrefix: string;
  locale: Locale;
  content: SiteContent["contact"];
  internalContactFixture?: InternalContactFixture;
}

const { idPrefix, locale, content, internalContactFixture } = Astro.props;
if (!/^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/.test(idPrefix)) {
  throw new Error("ContactForm idPrefix must be a deterministic lower-case HTML ID prefix");
}
const id = (suffix: string) => `${idPrefix}-${suffix}`;
const fixtureRequested = internalContactFixture !== undefined;
if (fixtureRequested && Astro.site?.origin !== "http://127.0.0.1:43219") {
  throw new Error("The internal contact fixture is restricted to its loopback-only build");
}
const defaultReadiness = resolveContactSubmissionReadiness(PUBLIC_CONTACT_SUBMISSION_ENABLED);
const readiness = fixtureRequested
  ? { ...defaultReadiness, submissionEnabled: true }
  : defaultReadiness;
const captchaSiteKey = internalContactFixture?.siteKey ?? PUBLIC_SMARTCAPTCHA_SITE_KEY;
if (readiness.submissionEnabled && !fixtureRequested) {
  assertReviewedPublicSmartCaptchaSiteKey(captchaSiteKey);
}
const disabled = !readiness.submissionEnabled;
const fixtureNotice = locale === "ru"
  ? `ВНУТРЕННИЙ ТЕСТОВЫЙ СТЕНД — ${readiness.consentIdentity} не действует; эта страница не предназначена для публикации.`
  : `INTERNAL TEST FIXTURE — ${readiness.consentIdentity} is not active; this page is not deployable.`;
const availabilityMessage = fixtureRequested
  ? fixtureNotice
  : disabled
    ? content.formDisabled
    : undefined;
---

<div class="contact-form-shell">
  <h3 id={id("title")}>{content.formTitle}</h3>
  {availabilityMessage && (
    <p class="contact-form-disabled" id={id("disabled")}>{availabilityMessage}</p>
  )}

  <form
    id={id("form")}
    method={readiness.submissionEnabled ? "post" : undefined}
    action={readiness.submissionEnabled ? "/api/contact" : undefined}
    novalidate
    data-contact-form
    data-contact-instance={idPrefix}
    data-submission-enabled={String(readiness.submissionEnabled)}
    data-consent-id={readiness.consentIdentity}
    data-source-path={locale === "ru" ? "/" : "/en/"}
    data-captcha-site-key={readiness.submissionEnabled ? captchaSiteKey : undefined}
    data-captcha-load-timeout-ms={internalContactFixture?.loadTimeoutMs}
    data-internal-test-fixture={fixtureRequested ? "true" : undefined}
    data-error-summary-message={content.errorSummary}
    aria-busy="false"
    aria-labelledby={id("title")}
    aria-describedby={availabilityMessage ? `${id("disabled")} ${id("note")}` : id("note")}
  >
    <p id={id("warning")} class="contact-form-warning" data-contact-warning>{content.formWarning}</p>
    <div id={id("error-summary")} class="contact-error-summary" data-contact-errors role="alert" hidden></div>

    <fieldset id={id("fields")} data-contact-fields disabled={disabled} aria-describedby={disabled ? id("disabled") : undefined}>
      <legend id={id("legend")} class="sr-only">{content.formTitle}</legend>

      <div class="contact-field">
        <label for={id("name")}>{content.formName}</label>
        <p id={id("name-instruction")}>{content.formNameInstruction}</p>
        <input
          id={id("name")}
          name="name"
          type="text"
          autocomplete="name"
          maxlength={CONTACT_FIELD_LIMITS.name}
          required
          aria-describedby={`${id("name-instruction")} ${id("name-error")}`}
        />
        <p id={id("name-error")} class="contact-field-error" data-contact-error="name" data-error-message={content.errors.name}></p>
      </div>

      <div class="contact-field">
        <label for={id("contact")}>{content.formContact}</label>
        <p id={id("contact-instruction")}>{content.formContactInstruction}</p>
        <input
          id={id("contact")}
          name="contact"
          type="text"
          inputmode="email"
          autocomplete="email"
          maxlength={CONTACT_FIELD_LIMITS.contact}
          required
          aria-describedby={`${id("contact-instruction")} ${id("contact-error")}`}
        />
        <p id={id("contact-error")} class="contact-field-error" data-contact-error="contact" data-error-message={content.errors.contact}></p>
      </div>

      <div class="contact-field">
        <label for={id("message")}>{content.formMessage}</label>
        <p id={id("message-instruction")}>{content.formMessageInstruction}</p>
        <textarea
          id={id("message")}
          name="message"
          rows="7"
          autocomplete="off"
          maxlength={CONTACT_FIELD_LIMITS.message}
          required
          aria-describedby={`${id("message-instruction")} ${id("message-error")}`}
        ></textarea>
        <p id={id("message-error")} class="contact-field-error" data-contact-error="message" data-error-message={content.errors.message}></p>
      </div>

      <div class="contact-field contact-consent">
        <label for={id("consent")}>
          <input
            id={id("consent")}
            name="consent"
            type="checkbox"
            value="accepted"
            required
            aria-describedby={`${id("consent-instruction")} ${id("consent-error")}`}
          />
          <span>
            {content.consentBeforePolicy}{" "}
            <a
              class="contact-consent-action"
              id={id("policy-link")}
              data-contact-consent-link="policy"
              href={localizedPath(locale, "privacy-policy")}
            >{content.policyLinkLabel}</a>
            {" "}{content.consentBetweenLinks}{" "}
            <a
              class="contact-consent-action"
              id={id("consent-link")}
              data-contact-consent-link="consent"
              href={localizedPath(locale, "personal-data-consent")}
            >{content.consentLinkLabel}</a>{content.consentAfterLinks}
          </span>
        </label>
        <p id={id("consent-instruction")}>
          {content.formConsentInstruction}{" "}
          <span class="contact-consent-identity" data-contact-consent-identity>{readiness.consentIdentity}</span>{" "}
          {content.consentDraftContext}
        </p>
        <p id={id("consent-error")} class="contact-field-error" data-contact-error="consent" data-error-message={content.errors.consent}></p>
      </div>

      <button id={id("submit")} class="contact-submit" type="submit" disabled={disabled}>{content.formSubmit}</button>
    </fieldset>

    <div id={id("captcha")} class="contact-captcha" data-contact-captcha></div>
    <p id={id("note")} class="contact-form-note">{content.formNote}</p>
    <p id={id("status")} data-contact-status role="status" aria-live="polite" aria-atomic="true"></p>
  </form>
</div>
