---
import { SITE_CONTENT, type Locale } from "@vbtech/content";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { THEME_STORAGE_KEY } from "../lib/theme.js";
import type { LocalizedRoute } from "../lib/locale.js";
import "../styles/global.css";

interface Alternate {
  locale: Locale | "x-default";
  path: string;
}

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternates: readonly Alternate[];
  localizedRoute?: LocalizedRoute;
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  canonicalPath,
  alternates,
  localizedRoute = "home",
  noindex = false,
} = Astro.props;
const { skip } = SITE_CONTENT[locale];
const themeBootstrap = `(() => {
  const root = document.documentElement;
  let stored = null;
  try {
    stored = window.localStorage.getItem(${JSON.stringify(THEME_STORAGE_KEY)});
  } catch {
    stored = null;
  }
  const mode = stored === "light" || stored === "dark" || stored === "system" ? stored : "system";
  let prefersDark = false;
  try {
    prefersDark = typeof window.matchMedia === "function" && window.matchMedia("(prefers-color-scheme: dark)").matches;
  } catch {
    prefersDark = false;
  }
  const theme = mode === "dark" || (mode === "system" && prefersDark) ? "dark" : "light";
  root.dataset.theme = theme;
  root.style.colorScheme = theme;
})();`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline set:html={themeBootstrap} />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin1-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {locale === "ru" && (
      <link
        rel="preload"
        href="/fonts/ibm-plex-sans-cyrillic-400.woff2"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    )}
    <SeoHead
      locale={locale}
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      alternates={alternates}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skip}</a>
    <SiteHeader locale={locale} route={localizedRoute} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <SiteFooter locale={locale} route={localizedRoute} />
    <script>
      import { initializeThemeControls } from "../scripts/theme";
      import { initializeContactForms } from "../scripts/contact-form";
      import { initializeNavigation } from "../scripts/navigation";

      initializeThemeControls();
      initializeNavigation();
      initializeContactForms();
    </script>
  </body>
</html>
