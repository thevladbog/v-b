{
  "name": "@vbtech/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-doc-forge.mjs && astro build",
    "build:contact-fixture": "VBTECH_INTERNAL_CONTACT_FIXTURE=1 astro build --config test-fixture/astro.config.mjs",
    "build:contact-active": "VBTECH_PRIVATE_ACTIVE_LEGAL_ARTIFACT=1 astro build --config test-active/astro.config.mjs",
    "preview:contact-fixture": "VBTECH_INTERNAL_CONTACT_FIXTURE=1 astro preview --config test-fixture/astro.config.mjs --host 127.0.0.1 --port 43219",
    "preview:contact-active": "VBTECH_PRIVATE_ACTIVE_LEGAL_ARTIFACT=1 astro preview --config test-active/astro.config.mjs --host 127.0.0.1 --port 43229",
    "test": "astro build && vitest run",
    "package-manager:contract": "node ../../scripts/assert-pnpm-runtime.mjs",
    "typecheck": "astro check",
    "lint": "astro check"
  },
  "dependencies": {
    "@vbtech/content": "workspace:*",
    "@vbtech/contracts": "workspace:*",
    "@vbtech/legal-documents": "workspace:*",
    "astro": "7.1.6",
    "docx": "^9.7.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@vbtech/contact-function": "workspace:*",
    "@vbtech/email": "workspace:*",
    "fflate": "^0.8.3",
    "parse5": "7.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
